{
  "HttpServer": {
    "Host": "127.0.0.1",
    "Port": 5001,
    "RequestTimeoutSeconds": 30
  },
  
  "Applications": {
    "Frista": {
      "ExecutablePath": "C:\\Frista\\Frista.exe",
      "StartupTimeoutSeconds": 45,
      "AutomationTimeoutSeconds": 30,
      "RetryAttempts": 3,
      "RetryDelayMs": 500
    },
    
    "Finger": {
      "ExecutablePath": "C:\\Program Files (x86)\\BPJS Kesehatan\\Aplikasi Sidik Jari BPJS Kesehatan\\After.exe",
      "StartupTimeoutSeconds": 45,
      "AutomationTimeoutSeconds": 30,
      "RetryAttempts": 3,
      "RetryDelayMs": 500
    }
  },
  
  "Credentials": {
    "FristaUsername": "xx",
    "FristaPassword": "xx$",
    "FingerUsername": "xx",
    "FingerPassword": "xx$"
  },
  
  "UIAutomation": {
    "PrimarySelectorStrategy": "AutomationId",
    "FallbackStrategies": [ "Name", "ControlType" ],
    "ElementWaitTimeMs": 1000,
    "MaxTreeDepth": 10,
    "EnableCaching": true,
    "CacheExpirationSeconds": 60
  },
  
  "Logging": {
    "LogPath": "logs/biometric-agent.log",
    "MinimumLevel": "Information",
    "UseStructuredLogging": true,
    "RollingInterval": "Day",
    "RetainedFileCountLimit": 7,
    "FileSizeLimitBytes": 104857600,
    "EnableConsoleLogging": true
  },
  
  "Performance": {
    "MaxConcurrentRequests": 1,
    "QueueTimeoutSeconds": 60,
    "EnableMetrics": true,
    "WarningThresholdSeconds": 5
  },
  
  "ErrorHandling": {
    "TerminateOnCriticalError": true,
    "MaxErrorRetries": 3,
    "RetryBackoffMultiplier": 2.0,
    "CaptureScreenshotOnError": false,
    "ScreenshotPath": "logs/screenshots"
  },
  
  "Health": {
    "CheckIntervalSeconds": 60,
    "MaxMemoryUsageMB": 200,
    "EnableHealthEndpoint": true
  },

  "Kiosk": {
    "Url": "http://172.16.3.94:8044/kiosk",
    "DelaySeconds": 2,
    "Fullscreen": true
  }
}
